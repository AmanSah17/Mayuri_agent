# =============================================================================
# Mayuri — Environment Configuration Template
# Copy this file to .env and fill in your values.
# NEVER commit your real .env to git.
# =============================================================================

# ── Ollama ────────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# ── Audio ─────────────────────────────────────────────────────────────────────
# Run `python -c "import sounddevice; print(sounddevice.query_devices())"` to list
# AUDIO_DEVICE_INDEX=        # leave blank for system default
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1

# ── Wake word ─────────────────────────────────────────────────────────────────
WAKE_WORD=mayuri
WAKE_WORD_THRESHOLD=0.5

# ── STT ───────────────────────────────────────────────────────────────────────
WHISPER_MODEL_SIZE=medium
WHISPER_DEVICE=cuda          # cuda | cpu
WHISPER_COMPUTE_TYPE=float16 # float16 | int8

# ── TTS ───────────────────────────────────────────────────────────────────────
PIPER_MODEL_PATH=models/tts/en_US-lessac-medium.onnx
PIPER_SPEAKER_ID=0

# ── VAD ───────────────────────────────────────────────────────────────────────
VAD_THRESHOLD=0.5
VAD_MIN_SILENCE_MS=700
VAD_SPEECH_PAD_MS=300

# ── FastAPI ───────────────────────────────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8765
API_WS_PATH=/ws/events

# ── PostgreSQL (long-term memory + conversation threads) ──────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mayuri
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_URL=postgresql+asyncpg://postgres:your_postgres_password@localhost:5432/mayuri
POSTGRES_SYNC_URL=postgresql://postgres:your_postgres_password@localhost:5432/mayuri

# ── SQLite (session cache — fast ephemeral store) ────────────────────────────
MEMORY_DB_PATH=data/mayuri.db
MEMORY_MAX_HISTORY=50

# ── LangSmith (tracing & debugging) ──────────────────────────────────────────
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=Mayuri

# ── Web search — Tavily ───────────────────────────────────────────────────────
TAVILY_API_KEY=your_tavily_api_key_here

# ── Web search — Exa ──────────────────────────────────────────────────────────
EXA_API_KEY=your_exa_api_key_here

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/mayuri.log
